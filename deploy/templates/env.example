# == ARGUS AGENT PROJECT ==
# Environment for docker compose.
#
#   cp deploy/templates/env.example deploy/compose/.env
#   chmod 600 deploy/compose/.env
#
# THIS FILE HOLDS SECRETS. It must be mode 600, it must never be committed, and it
# must never be copied into an image — `.dockerignore` excludes it, and the
# Dockerfile has no `COPY .env`.

# ── the bot ─────────────────────────────────────────────────────────────────────

# From @BotFather: /newbot, then the token it replies with.
# Anyone with this can drive the system as the bot. Treat it as a private key; use
# /revoke with BotFather if it leaks.
TELEGRAM_BOT_TOKEN=

# ── providers ───────────────────────────────────────────────────────────────────
#
# A model is configured as `provider/model`, and its provider's key is ALWAYS
# <PROVIDER>_API_KEY: the provider in upper case, `-` and `.` as `_`. A project
# whose provider has no key is refused at configuration time, naming the variable.
# Only the providers your projects use need one.

DEEPSEEK_API_KEY=
# Any OpenRouter model, as `openrouter/<vendor>/<model>` (e.g. openrouter/z-ai/glm-5.3-flash).
OPENROUTER_API_KEY=
# ZAI_API_KEY=            zai/glm-5.3-flash
# ANTHROPIC_API_KEY=      anthropic/claude-haiku-4-5
# OPENAI_API_KEY=
# GOOGLE_API_KEY=         google/gemini-…   (not GEMINI_API_KEY: the rule is mechanical)
# GROQ_API_KEY=  MISTRAL_API_KEY=  XAI_API_KEY=  TOGETHER_API_KEY=  FIREWORKS_API_KEY=
# A provider declared in ops.yaml → providers: (e.g. deepinfra) follows the same rule:
# DEEPINFRA_API_KEY=

# A local Ollama needs no key: declare it in ops.yaml → providers: with key: none.

# ── deployment ──────────────────────────────────────────────────────────────────

# The image to run. Pin a TAG in production, never `latest`: an upgrade should be a
# decision, and `latest` makes it happen on the next restart.
ARGUS_AGENT_IMAGE=ghcr.io/rla-labs/argus:0.2.1

# The data directory ON THE HOST. This is the only path that persists.
ARGUS_AGENT_DATA_PATH=/srv/argus-agent/data

# The configuration file INSIDE the container.
ARGUS_AGENT_CONFIG=/data/config/ops.yaml

# The container's timezone. Also set `timezone` in ops.yaml: this one is for the
# container's clock and logs, that one for budget boundaries and reports.
TZ=Europe/Bucharest

# ── optional ────────────────────────────────────────────────────────────────────

# Where Ollama keeps its models, when using the overlay.
# OLLAMA_MODELS_PATH=/srv/argus-agent/ollama
