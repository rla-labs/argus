{
  "name": "@argus-agent/web",
  "version": "0.7.2",
  "description": "The web interface: a dashboard, approvals, settings and a chat channel, on a private network",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "public/**"
  ],
  "license": "SEE LICENSE IN LICENSE.md",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.client.json",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p tsconfig.client.json --noEmit"
  },
  "dependencies": {
    "@argus-agent/approvals-bridge": "workspace:*",
    "@argus-agent/argus-agent": "workspace:*",
    "@argus-agent/channel": "workspace:*",
    "@argus-agent/commands": "workspace:*",
    "@argus-agent/governor": "workspace:*",
    "@argus-agent/meter": "workspace:*",
    "@argus-agent/projects": "workspace:*",
    "@argus-agent/store": "workspace:*",
    "@argus-agent/types": "workspace:*",
    "@deepseek-ai/schemastery": "3.18.4",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "htm": "3.1.1",
    "preact": "10.29.8",
    "yaml": "2.6.1"
  },
  "devDependencies": {
    "@argus-agent/memory": "workspace:^",
    "@argus-agent/scheduler": "workspace:^",
    "@argus-agent/testkit": "workspace:*",
    "@argus-agent/web": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4"
  }
}
