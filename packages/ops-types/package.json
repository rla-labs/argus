{
  "name": "@argus-agent/types",
  "version": "0.2.1",
  "description": "Shared types, branded primitives, and the OpsError hierarchy every Argus Agent plugin depends on",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4"
  }
}
