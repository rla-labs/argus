{
  "name": "@argus-agent/projects",
  "version": "0.2.1",
  "description": "Owns the lifecycle of every dsh agent: project agents, ad-hoc task agents and the orchestrator, plus the session ownership map",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@argus-agent/types": "workspace:*",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.0-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.0-rc.2",
    "yaml": "2.6.1",
    "@argus-agent/argus-agent": "workspace:*",
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "devDependencies": {
    "@argus-agent/argus-agent": "workspace:*",
    "@argus-agent/store": "workspace:*",
    "@argus-agent/testkit": "workspace:*",
    "@deepseek-ai/dsh-agent-loop": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@argus-agent/projects": "workspace:*",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.0-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4"
  }
}
