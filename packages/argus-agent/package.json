{
  "name": "@argus-agent/argus-agent",
  "version": "0.1.0",
  "description": "The Argus Agent bundle: composes every ops-* plugin into one dsh bundle",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./registry-row": {
      "types": "./lib/registry-row.d.ts",
      "default": "./lib/registry-row.js"
    },
    "./loader-row": {
      "types": "./lib/loader-row.d.ts",
      "default": "./lib/loader-row.js"
    },
    "./log-row": {
      "types": "./lib/log-row.d.ts",
      "default": "./lib/log-row.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4",
    "yaml": "2.6.1",
    "@deepseek-ai/dsh-user-approval": "0.2.0-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@argus-agent/store": "workspace:*",
    "@argus-agent/projects": "workspace:*",
    "@argus-agent/meter": "workspace:*",
    "@argus-agent/governor": "workspace:*",
    "@argus-agent/commands": "workspace:*",
    "@argus-agent/channel": "workspace:*",
    "@argus-agent/telegram": "workspace:*",
    "@argus-agent/orchestrator": "workspace:*",
    "@argus-agent/scheduler": "workspace:*",
    "@argus-agent/approvals-bridge": "workspace:*",
    "@argus-agent/memory": "workspace:*",
    "@argus-agent/health": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependenciesMeta": {
    "@argus-agent/store": {
      "optional": true
    }
  },
  "devDependencies": {
    "@argus-agent/types": "workspace:*"
  }
}
