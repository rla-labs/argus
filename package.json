{
  "name": "argus-agent",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@8.6.11",
  "scripts": {
    "build": "pnpm -r --filter './packages/**' run build",
    "typecheck": "pnpm -r --filter './packages/**' run typecheck",
    "test": "vitest run && tsx scripts/check-docs.ts",
    "test:unit": "vitest run --project packages",
    "test:spikes": "vitest run --project spikes",
    "test:e2e": "vitest run --project e2e",
    "test:live": "ARGUS_LIVE=1 vitest run --project live",
    "lint": "oxlint packages test scripts profiles && bash scripts/lint-shell.sh",
    "check-docs": "tsx scripts/check-docs.ts",
    "spikes": "vitest run --project spikes --reporter=verbose",
    "lint:shell": "bash scripts/lint-shell.sh",
    "test:native-vps": "bash scripts/test-native-vps.sh"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "oxlint": "0.9.10",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8",
    "@argus-agent/types": "workspace:*",
    "@argus-agent/testkit": "workspace:*",
    "@argus-agent/argus-agent": "workspace:*",
    "@argus-agent/store": "workspace:*",
    "better-sqlite3": "11.5.0",
    "@types/better-sqlite3": "7.6.11",
    "@argus-agent/projects": "workspace:*",
    "@argus-agent/meter": "workspace:*",
    "@argus-agent/governor": "workspace:*",
    "@argus-agent/commands": "workspace:*",
    "@argus-agent/channel": "workspace:*",
    "@argus-agent/scheduler": "workspace:*",
    "@argus-agent/memory": "workspace:*",
    "@argus-agent/health": "workspace:*",
    "@argus-agent/approvals-bridge": "workspace:*",
    "@argus-agent/orchestrator": "workspace:*",
    "yaml": "2.6.1",
    "@argus-agent/telegram": "workspace:*",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.0-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-preset": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.0-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.2.0-rc.2",
    "@deepseek-ai/dsh-base": "0.2.0-rc.2",
    "@deepseek-ai/dsh-cmdline": "0.2.0-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.0-rc.2",
    "@deepseek-ai/dsh-headless": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.0-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4"
  }
}
